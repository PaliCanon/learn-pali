{"uid":"dhp116-128","display_id":"DHP 116-128","title":"Phẩm Ác","pali_title":"Cūḷekasāṭakabrāhmaṇavatthu","lang":"vi","translator":"phantuananh","segmentation":"paragraph","segments":[{"key":"dhp116:0.1","text":"Tiểu Bộ Kinh"},{"key":"dhp116:0.2","text":"Kinh Pháp Cú"},{"key":"dhp116:0.3","text":"Phẩm Ác"},{"key":"dhp116:0.4","text":"Chuyện Bà-la-môn Cūḷekasātaka (Tiểu Trung Y)"},{"key":"dhp116:1","text":"Hãy gấp làm điều lành,"},{"key":"dhp116:2","text":"Ngăn tâm làm điều ác."},{"key":"dhp116:3","text":"Ai chậm làm việc lành,"},{"key":"dhp116:4","text":"Ý ưa thích việc ác."},{"key":"dhp117:0","text":"Chuyện Trưởng lão Seyyasaka"},{"key":"dhp117:1","text":"Nếu người làm điều ác,"},{"key":"dhp117:2","text":"Chớ tiếp tục làm thêm."},{"key":"dhp117:3","text":"Chớ ước muốn điều ác,"},{"key":"dhp117:4","text":"Chứa ác, tất chịu khổ."},{"key":"dhp118:0","text":"Chuyện Thiên nữ Lājā (Cốm Rang)"},{"key":"dhp118:1","text":"Nếu người làm điều thiện,"},{"key":"dhp118:2","text":"Nên tiếp tục làm thêm."},{"key":"dhp118:3","text":"Hãy ước muốn điều thiện,"},{"key":"dhp118:4","text":"Chứa thiện, được an lạc."},{"key":"dhp119:0","text":"Chuyện Trưởng giả Anāthapiṇḍika (Cấp Cô Độc)"},{"key":"dhp119:1","text":"Người ác thấy là hiền."},{"key":"dhp119:2","text":"Khi ác chưa chín muồi,"},{"key":"dhp119:3","text":"Khi ác nghiệp chín muồi,"},{"key":"dhp119:4","text":"Người ác mới thấy ác."},{"key":"dhp120:1","text":"Người hiền thấy là ác,"},{"key":"dhp120:2","text":"Khi thiện chưa chín muồi,"},{"key":"dhp120:3","text":"Khi thiện nghiệp chín muồi,"},{"key":"dhp120:4","text":"Người hiền thấy là thiện."},{"key":"dhp121:0","text":"Chuyện vị Tỳ-khoe khinh giới nhỏ"},{"key":"dhp121:1","text":"Chớ chê khinh điều ác,"},{"key":"dhp121:2","text":"Cho rằng “chưa đến mình”,"},{"key":"dhp121:3","text":"Như nước nhỏ từng giọt,"},{"key":"dhp121:4","text":"Rồi bình cũng đầy tràn."},{"key":"dhp121:5","text":"Người ngu chứa đầy ác"},{"key":"dhp121:6","text":"Do chất chứa dần dần."},{"key":"dhp122:0","text":"Chuyện Bá hộ Biḷālapādaka (Chân Mèo)"},{"key":"dhp122:1","text":"Chớ chê khinh điều thiện"},{"key":"dhp122:2","text":"Cho rằng “chưa đến mình”,"},{"key":"dhp122:3","text":"Như nước nhỏ từng giọt,"},{"key":"dhp122:4","text":"Rồi bình cũng đầy tràn."},{"key":"dhp122:5","text":"Người trí chứa đầy thiện,"},{"key":"dhp122:6","text":"Do chất chứa dần dần."},{"key":"dhp123:0","text":"Chuyện phú thương tránh hiểm lộ"},{"key":"dhp123:1","text":"Ít bạn đường, nhiều tiền,"},{"key":"dhp123:2","text":"Người buôn tránh đường hiểm."},{"key":"dhp123:3","text":"Muốn sống, tránh thuốc độc,"},{"key":"dhp123:4","text":"Hãy tránh ác như vậy."},{"key":"dhp124:0","text":"Chuyện thợ săn Kukkuṭamitta (Kê Hữu)"},{"key":"dhp124:1","text":"Bàn tay không thương tích,"},{"key":"dhp124:2","text":"Có thể cầm thuốc độc."},{"key":"dhp124:3","text":"Không thương tích, tránh độc,"},{"key":"dhp124:4","text":"Không làm, không có ác."},{"key":"dhp125:0","text":"Chuyện thợ săn Koka gặp sa-môn"},{"key":"dhp125:1","text":"Hại người không ác tâm,"},{"key":"dhp125:2","text":"Người thanh tịnh, không uế,"},{"key":"dhp125:3","text":"Tội ác đến kẻ ngu,"},{"key":"dhp125:4","text":"Như ngược gió tung bụi."},{"key":"dhp126:0","text":"Chuyện Trưởng lão Tissa và người thợ ngọc thị giả"},{"key":"dhp126:1","text":"Một số sinh bào thai,"},{"key":"dhp126:2","text":"Kẻ ác sinh địa ngục,"},{"key":"dhp126:3","text":"Người thiện lên cõi trời,"},{"key":"dhp126:4","text":"Vô lậu chứng Niết-bàn."},{"key":"dhp127:0","text":"Chuyện 3 nhóm Tỳ-kheo"},{"key":"dhp127:1","text":"Không trên trời, giữa biển,"},{"key":"dhp127:2","text":"Không lánh vào động núi,"},{"key":"dhp127:3","text":"Không chỗ nào trên đời,"},{"key":"dhp127:4","text":"Trốn được quả ác nghiệp."},{"key":"dhp128:0","text":"Chuyện vua Suppabuddhasakka (Thiện Giác)"},{"key":"dhp128:1","text":"Không trên trời, giữa biển,"},{"key":"dhp128:2","text":"Không lánh vào động núi,"},{"key":"dhp128:3","text":"Không chỗ nào trên đời,"},{"key":"dhp128:4","text":"Trốn khỏi tay thần chết."},{"key":"dhp128:5","text":"Hết phẩm Ác"}]}