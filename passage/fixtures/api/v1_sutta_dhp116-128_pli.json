{"uid":"dhp116-128","display_id":"DHP116-128","title":"9. Wickedness","pali_title":"Cūḷekasāṭakabrāhmaṇavatthu","lang":"pli","translator":"ms","segmentation":"segment","segments":[{"key":"dhp116:0.1","text":"Khuddakanikāya"},{"key":"dhp116:0.2","text":"Dhammapada"},{"key":"dhp116:0.3","text":"Pāpavagga"},{"key":"dhp116:0.4","text":"Cūḷekasāṭakabrāhmaṇavatthu"},{"key":"dhp116:1","text":"Abhittharetha kalyāṇe,"},{"key":"dhp116:2","text":"pāpā cittaṁ nivāraye;"},{"key":"dhp116:3","text":"Dandhañhi karoto puññaṁ,"},{"key":"dhp116:4","text":"pāpasmiṁ ramatī mano."},{"key":"dhp117:0","text":"Seyyasakattheravatthu"},{"key":"dhp117:1","text":"Pāpañce puriso kayirā,"},{"key":"dhp117:2","text":"Na naṁ kayirā punappunaṁ;"},{"key":"dhp117:3","text":"Na tamhi chandaṁ kayirātha,"},{"key":"dhp117:4","text":"Dukkho pāpassa uccayo."},{"key":"dhp118:0","text":"Lājadevadhītāvatthu"},{"key":"dhp118:1","text":"Puññañce puriso kayirā,"},{"key":"dhp118:2","text":"kayirā naṁ punappunaṁ;"},{"key":"dhp118:3","text":"Tamhi chandaṁ kayirātha,"},{"key":"dhp118:4","text":"sukho puññassa uccayo."},{"key":"dhp119:0","text":"Anāthapiṇḍikaseṭṭhivatthu"},{"key":"dhp119:1","text":"Pāpopi passati bhadraṁ,"},{"key":"dhp119:2","text":"Yāva pāpaṁ na paccati;"},{"key":"dhp119:3","text":"Yadā ca paccati pāpaṁ,"},{"key":"dhp119:4","text":"Atha pāpo pāpāni passati."},{"key":"dhp120:1","text":"Bhadropi passati pāpaṁ,"},{"key":"dhp120:2","text":"Yāva bhadraṁ na paccati;"},{"key":"dhp120:3","text":"Yadā ca paccati bhadraṁ,"},{"key":"dhp120:4","text":"Atha bhadro bhadrāni passati."},{"key":"dhp121:0","text":"Asaññataparikkhāravatthu"},{"key":"dhp121:1","text":"Māvamaññetha pāpassa,"},{"key":"dhp121:2","text":"na mantaṁ āgamissati;"},{"key":"dhp121:3","text":"Udabindunipātena,"},{"key":"dhp121:4","text":"udakumbhopi pūrati;"},{"key":"dhp121:5","text":"Bālo pūrati pāpassa,"},{"key":"dhp121:6","text":"thokaṁ thokampi ācinaṁ."},{"key":"dhp122:0","text":"Biḷālapādakaseṭṭhivatthu"},{"key":"dhp122:1","text":"Māvamaññetha puññassa,"},{"key":"dhp122:2","text":"na mandaṁ āgamissati;"},{"key":"dhp122:3","text":"Udabindunipātena,"},{"key":"dhp122:4","text":"udakumbhopi pūrati;"},{"key":"dhp122:5","text":"Dhīro pūrati puññassa,"},{"key":"dhp122:6","text":"thokaṁ thokampi ācinaṁ."},{"key":"dhp123:0","text":"Mahādhanavāṇijavatthu"},{"key":"dhp123:1","text":"Vāṇijova bhayaṁ maggaṁ,"},{"key":"dhp123:2","text":"appasattho mahaddhano;"},{"key":"dhp123:3","text":"Visaṁ jīvitukāmova,"},{"key":"dhp123:4","text":"pāpāni parivajjaye."},{"key":"dhp124:0","text":"Kukkuṭamittanesādavatthu"},{"key":"dhp124:1","text":"Pāṇimhi ce vaṇo nāssa,"},{"key":"dhp124:2","text":"hareyya pāṇinā visaṁ;"},{"key":"dhp124:3","text":"Nābbaṇaṁ visamanveti,"},{"key":"dhp124:4","text":"natthi pāpaṁ akubbato."},{"key":"dhp125:0","text":"Kokasunakhaluddakavatthu"},{"key":"dhp125:1","text":"Yo appaduṭṭhassa narassa dussati,"},{"key":"dhp125:2","text":"Suddhassa posassa anaṅgaṇassa;"},{"key":"dhp125:3","text":"Tameva bālaṁ pacceti pāpaṁ,"},{"key":"dhp125:4","text":"Sukhumo rajo paṭivātaṁva khitto."},{"key":"dhp126:0","text":"Maṇikārakulūpakatissattheravatthu"},{"key":"dhp126:1","text":"Gabbhameke uppajjanti,"},{"key":"dhp126:2","text":"nirayaṁ pāpakammino;"},{"key":"dhp126:3","text":"Saggaṁ sugatino yanti,"},{"key":"dhp126:4","text":"parinibbanti anāsavā."},{"key":"dhp127:0","text":"Tayojanavatthu"},{"key":"dhp127:1","text":"Na antalikkhe na samuddamajjhe,"},{"key":"dhp127:2","text":"Na pabbatānaṁ vivaraṁ pavissa;"},{"key":"dhp127:3","text":"Na vijjatī so jagatippadeso,"},{"key":"dhp127:4","text":"Yatthaṭṭhito mucceyya pāpakammā."},{"key":"dhp128:0","text":"Suppabuddhasakyavatthu"},{"key":"dhp128:1","text":"Na antalikkhe na samuddamajjhe,"},{"key":"dhp128:2","text":"Na pabbatānaṁ vivaraṁ pavissa;"},{"key":"dhp128:3","text":"Na vijjatī so jagatippadeso,"},{"key":"dhp128:4","text":"Yatthaṭṭhitaṁ nappasaheyya maccu."},{"key":"dhp128:5","text":"Pāpavaggo navamo."}]}