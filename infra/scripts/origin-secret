#!/usr/bin/env bash
# The origin secret of learn-pali (task 031): the value the Cloudflare Worker
# sends as `x-origin-auth` and the service requires. It lives in Secret
# Manager (`learn-pali-origin-secret-<env>`, read by the service) and in the
# Worker's secret store (binding `ORIGIN_AUTH`). Neither is in tofu state:
# tofu creates the empty secret and the Worker, this script fills them.
#
#   origin-secret create <dev|prod>   generate the value, add it as the
#                                     secret's first version (does nothing
#                                     when a version exists)
#   origin-secret push   <dev|prod>   copy the latest version into the
#                                     Worker (Cloudflare API); the HTTP code
#                                     is checked
#   origin-secret check  <dev|prod>   print OK, or "not OK" and the name of
#                                     the first failing check:
#                                       version          a version exists
#                                       worker-secret    the Cloudflare API lists the
#                                                        Worker's secrets (any other
#                                                        answer is "Cloudflare API
#                                                        error <code>") and ORIGIN_AUTH
#                                                        is one
#                                       access-redirect  the host answers 302 to
#                                                        *.cloudflareaccess.com (dev,
#                                                        behind Access; the rule is
#                                                        scripts/access-redirect-pattern,
#                                                        shared with rollout-check.sh
#                                                        --access); prod is public: it
#                                                        answers 200
#
# The value is never printed and never an argument: it travels on stdin
# (`gcloud ... --data-file=-`, `curl --config -`). `push` and `check` need
# CLOUDFLARE_API_TOKEN in the environment (from the keychain, README).
# `push` is re-run after any `tofu apply` that touches the Worker (the
# provider can drop a secret it does not declare). Rotation (infra/README.md):
# add a new version by hand, `push` it (the Worker now sends the new value),
# then start a new revision that reads it; until that revision serves the
# service answers the Worker with 403 (no two-value overlap, a few seconds).
set -euo pipefail

PROJECT=${PROJECT:-palicanon-app}
ACCOUNT=${CLOUDFLARE_ACCOUNT_ID:-c0690c72f1b7c85737052c3a9ebac154}
MAX_TIME=${MAX_TIME:-20}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
access_pattern_file="$here/../../scripts/access-redirect-pattern"

usage() {
  echo "usage: origin-secret <create|push|check> <dev|prod>" >&2
  exit 2
}

cmd=${1:-}
env_name=${2:-}
case "$cmd" in create | push | check) ;; *) usage ;; esac
case "$env_name" in
  dev) host=${HOST:-learn.dev.palicanon.app} ;;
  prod) host=${HOST:-learn.palicanon.app} ;;
  *) usage ;;
esac
secret="learn-pali-origin-secret-$env_name"
worker="learn-pali-$env_name"
api="https://api.cloudflare.com/client/v4/accounts/$ACCOUNT/workers/scripts/$worker/secrets"

has_version() {
  local found
  found=$(gcloud secrets versions list "$secret" --project "$PROJECT" --filter 'state=enabled' --limit 1 --format 'value(name)')
  [ -n "$found" ]
}

# A curl call whose arguments are a config on stdin: neither the Cloudflare
# token nor the value is ever in an argv. Extra config lines are the
# arguments after the method.
cf_call() { # cf_call METHOD [CONFIG_LINE...] -> curl's stdout
  local method=$1
  shift
  : "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is not set (README: the keychain)}"
  printf '%s\n' \
    "url = \"$api\"" \
    "request = \"$method\"" \
    "header = \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\"" \
    'header = "Content-Type: application/json"' \
    "max-time = $MAX_TIME" \
    'silent' 'show-error' "$@" | curl --config -
}

do_create() {
  if has_version; then
    echo "origin-secret: $secret already has a version; nothing to do"
    return 0
  fi
  openssl rand -hex 32 | gcloud secrets versions add "$secret" --project "$PROJECT" --data-file=- >/dev/null
  echo "origin-secret: $secret created (the value is not shown)"
}

do_push() {
  : "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is not set (README: the keychain)}"
  local value code
  value=$(gcloud secrets versions access latest --secret "$secret" --project "$PROJECT")
  [ -n "$value" ] || { echo "origin-secret: $secret has no value; run create first" >&2; return 1; }
  # The value goes into a JSON string inside a curl config string: only
  # characters that need no escaping in either (`create` makes hex).
  case "$value" in *[!A-Za-z0-9+/=_-]*) echo "origin-secret: the value has characters this script does not escape" >&2; return 1 ;; esac
  code=$(cf_call PUT \
    "data = \"{\\\"name\\\":\\\"ORIGIN_AUTH\\\",\\\"text\\\":\\\"$value\\\",\\\"type\\\":\\\"secret_text\\\"}\"" \
    'output = "/dev/null"' 'write-out = "%{http_code}"') || code=000
  case "$code" in
    2??) echo "origin-secret: $worker has the secret (HTTP $code)" ;;
    *) echo "origin-secret: Cloudflare answered HTTP $code; $worker was not updated" >&2; return 1 ;;
  esac
}

# The host check: dev sits behind Access (302 to *.cloudflareaccess.com);
# prod is public (200). Prints nothing but the verdict.
check_host() {
  local answer code location
  answer=$(curl --silent --show-error --max-time "$MAX_TIME" --output /dev/null \
    --write-out '%{http_code} %{redirect_url}' "https://$host/") || answer="000 "
  code=${answer%% *}
  location=${answer#* }
  if [ "$env_name" = prod ]; then
    [ "$code" = 200 ] && return 0
    echo "not OK: check 'access-redirect' failed: https://$host/ answered HTTP $code (prod is public: 200 expected)"
    return 1
  fi
  # A rule that cannot be read must say so, not pass for "redirects elsewhere".
  if [ ! -s "$access_pattern_file" ] || [ ! -r "$access_pattern_file" ]; then
    echo "not OK: check 'access-redirect' failed: the pattern file $access_pattern_file is missing, empty or unreadable: the redirect cannot be judged"
    return 1
  fi
  case "$code" in
    302)
      # The host part only: a path or a lookalike domain does not count.
      # One rule for this script and rollout-check.sh --access.
      if grep -Eiq -f "$access_pattern_file" <<<"$location"; then return 0; fi
      echo "not OK: check 'access-redirect' failed: https://$host/ redirects elsewhere than *.cloudflareaccess.com" ;;
    200) echo "not OK: check 'access-redirect' failed: https://$host/ answered HTTP 200 (Access is missing)" ;;
    *) echo "not OK: check 'access-redirect' failed: https://$host/ answered HTTP $code (302 to cloudflareaccess.com expected)" ;;
  esac
  return 1
}

# The Worker's secret names, or a message and a failure: a non-2xx answer or
# `"success": false` is a Cloudflare API error, never "no ORIGIN_AUTH". Sets
# `names` (the caller's local).
worker_secret_names() {
  local answer code
  answer=$(cf_call GET 'write-out = "\n%{http_code}"') || answer=""
  code=${answer##*$'\n'}
  case "$code" in [0-9][0-9][0-9]) ;; *) code=000 ;; esac
  names=${answer%$'\n'*}
  case "$code" in
    2??) ;;
    *) echo "not OK: check 'worker-secret' failed: Cloudflare API error $code listing the secrets of the Worker $worker"; return 1 ;;
  esac
  if grep -Eq '"success": *false' <<<"$names"; then
    echo "not OK: check 'worker-secret' failed: Cloudflare API error $code (success: false) listing the secrets of the Worker $worker"
    return 1
  fi
}

# OK, or "not OK" and the first failing check by name. Prints no value.
do_check() {
  : "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is not set (README: the keychain)}"
  local names
  has_version || { echo "not OK: check 'version' failed: $secret has no enabled version (run create)"; return 1; }
  # Captured, and read through a here-string: a pipe into `grep -q` can be
  # closed by grep at the first match, and pipefail reads that as a failure.
  worker_secret_names || return 1
  grep -Eq '"name": *"ORIGIN_AUTH"' <<<"$names" \
    || { echo "not OK: check 'worker-secret' failed: the Worker $worker has no ORIGIN_AUTH secret (run push)"; return 1; }
  check_host || return 1
  echo "OK"
}

case "$cmd" in
  create) do_create ;;
  push) do_push ;;
  check) do_check ;;
esac
