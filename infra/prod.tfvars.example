# The second apply, once dev has deployed from CI and been checked:
#   tofu apply -var-file=prod.tfvars   (copy this file to prod.tfvars)
# `envs` is replaced as a whole, so dev is listed again. Neither host has
# Cloudflare Access (`access` is false when omitted): both are public behind
# the origin guard, and `admin_emails` is not needed.
envs = {
  dev = {
    host          = "learn.dev.palicanon.app"
    max_instances = 2
  }
  prod = {
    host          = "learn.palicanon.app"
    max_instances = 3
  }
}

# Only for an env that sets `access = true` (Cloudflare Access): who passes
# it. Not stored in the repository: pass it as
# TF_VAR_admin_emails='["you@example.com"]' or uncomment it in your own
# prod.tfvars (never commit that file). An env with Access and no address
# is refused.
# admin_emails = ["you@example.com"]
